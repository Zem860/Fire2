@inherits System.Web.Mvc.WebViewPage<IEnumerable<Fire2.Areas.Front.Models.NavbarItems>>

@foreach (var item in Model)
{
    <li class="dropdown">
        <a href="@item.Link" class="dropdown-toggle" data-toggle="dropdown">
            @item.NavbarItem <i class="fa fa-angle-down"></i>
        </a>

        @if (item.Children != null && item.Children.Any(c => !c.ShowForLoggedInUsers))
        {
            <ul class="dropdown-menu" role="menu">
                @foreach (var child in item.Children.Where(c => !c.ShowForLoggedInUsers))
                {
                    <li><a href="@child.Link">@child.NavbarItem</a></li>
                }
            </ul>
        }

    </li>
}