@inherits System.Web.Mvc.WebViewPage<Fire2.Areas.Front.Models.MemberRegisterViewModel>

@using System.Web.Mvc.Html;
@using System.Web.Mvc;
@{
    Layout = "~/Areas/Front/Views/Shared/_Layout.cshtml";
}
@{
    Html.EnableClientValidation();
    Html.EnableUnobtrusiveJavaScript();
}

<!DOCTYPE html>
<html>

<head>
    <!-- Basic Page Needs
    ================================================== -->
    <meta charset="utf-8">
    <title>國際縱火調查人員協會臺灣分會</title>
    <!-- Mobile Specific Metas
    ================================================== -->
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <!-- Favicons
    ================================================== -->
    <link rel="shortcut icon" href="images/favicon.ico" type="image/x-icon" />
    <!-- CSS
    ================================================== -->
    <!-- Bootstrap -->
    <link rel="stylesheet" href="css/bootstrap.min.css">
    <!-- Template styles-->
    <link rel="stylesheet" href="css/style.css">
    <!-- Responsive styles-->
    <link rel="stylesheet" href="css/responsive.css">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="css/font-awesome.min.css">
    <!-- Animation -->
    <link rel="stylesheet" href="css/animate.css">
    <!-- Owl Carousel -->
    <link rel="stylesheet" href="css/owl.carousel.css">
    <link rel="stylesheet" href="css/owl.theme.css">
    <!-- Colorbox -->
    <link rel="stylesheet" href="css/colorbox.css">
    <!-- HTML5 shim, for IE6-8 support of HTML5 elements. All other JS at the end of file. -->
    <!--[if lt IE 9]>
      <script src="js/html5shiv.js"></script>
      <script src="js/respond.min.js"></script>
    <![endif]-->
</head>

<body>
    <div class="body-inner">
        <div id="banner-area" class="banner-area" style="background-image:url('@Url.Content("~/Content/images/banner-bg.jpg")')">
            <!-- Subpage title start -->
            <div class="banner-text text-right">
                <div class="container">
                    <div class="row">
                        <div class="col-xs-12">
                            <ul class="breadcrumb">
                                <li>首頁</li>
                                <li>會員專區</li>
                                <li><a href="#"> 會員註冊</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Subpage title end -->
        </div>
        <!-- Banner area end -->
        <section id="main-container" class="main-container">
            <div class="container">
                <div class="row">
                    <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                        <div class="sidebar sidebar-right">
                            <div class="widget">
                                <h2 class="widget-title"><i class="fa fa-folder-open-o">&nbsp;</i>會員專區</h2>
                                <ul class="arrow nav nav-tabs nav-stacked">
                                    <li><a href="#">檔案下載</a></li>
                                    <li class="active"><a href="#">會員註冊</a></li>
                                </ul>
                            </div>
                            <!-- Categories end -->
                        </div>
                        <!-- Sidebar end -->
                    </div>
                    <!-- Sidebar Col end -->
                    <div class="col-lg-9 col-md-9 col-sm-12 col-xs-12">
                        <h2 class="page-title">會員註冊</h2>
                        <hr class="botmargin-min">
                        <!-- 內容開始 -->
                        @if (TempData["Success"] == null)
                        {

                            using (Html.BeginForm("SubmitRegister", "Member", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" }))
                            {
                                @Html.AntiForgeryToken()
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Member.Account, htmlAttributes: new { @class = "col-sm-2 control-label" })
                                    <div class="col-sm-7">
                                        @Html.TextBoxFor(m => m.Member.Account, new { @class = "form-control", placeholder = "請輸入帳號" })
                                    </div>
                                    <div class="col-sm-3">
                                        @Html.ValidationMessageFor(m => m.Member.Account, "", new { @class = "altred" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(m => m.Member.PasswordHash, htmlAttributes: new { @class = "col-sm-2 control-label" })
                                    <div class="col-sm-7">
                                        @Html.TextBoxFor(m => m.Member.PasswordHash, new { @class = "form-control", placeholder = "請輸入密碼" })
                                    </div>
                                    <div class="col-sm-3">
                                        @Html.ValidationMessageFor(m => m.Member.PasswordHash, "", new { @class = "altred" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Member.Name, htmlAttributes: new { @class = "col-sm-2 control-label" })
                                    <div class="col-sm-7">
                                        @Html.TextBoxFor(m => m.Member.Name, new { @class = "form-control", placeholder = "請輸入姓名" })
                                    </div>
                                    <div class="col-sm-3">
                                        @Html.ValidationMessageFor(m => m.Member.Name, "", new { @class = "alertred" })

                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(m => m.Member.Gender, htmlAttributes: new { @class = "col-sm-2 control-label" })

                                    <div class="col-sm-7">

                                        <label class="radio-inline">
                                            @Html.RadioButtonFor(m => m.Member.Gender, Fire2.Areas.Front.Models.GenderEnum.男) 男
                                        </label>
                                        <label class="radio-inline">
                                            @Html.RadioButtonFor(m => m.Member.Gender, Fire2.Areas.Front.Models.GenderEnum.女) 女
                                        </label>

                                    </div>
                                    <div class="col-sm-3">
                                        @Html.ValidationMessageFor(m => m.Member.Gender, "", new { @class = "alertred" })

                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(m => m.Member.Birthday, htmlAttributes: new { @class = "col-sm-2 control-label" })
                                    <div class="col-sm-7">
                                        @Html.TextBoxFor(m => m.Member.Birthday, new { @class = "form-control", type = "date" })
                                    </div>
                                    <div class="col-sm-3">
                                        @Html.ValidationMessageFor(m => m.Member.Birthday, "", new { @class = "alertred" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(m => m.Member.MembershipType, htmlAttributes: new { @class = "col-sm-2 control-label" })
                                    <div class="col-sm-7">
                                        <label class="radio-inline">
                                            @Html.RadioButtonFor(m => m.Member.MembershipType, Fire2.Areas.Front.Models.Membership.正式會員) 正式會員
                                        </label>
                                        <label class="radio-inline">
                                            @Html.RadioButtonFor(m => m.Member.MembershipType, Fire2.Areas.Front.Models.Membership.準會員) 準會員
                                        </label>
                                        <label class="radio-inline">
                                            @Html.RadioButtonFor(m => m.Member.MembershipType, Fire2.Areas.Front.Models.Membership.個人贊助會員) 個人贊助會員
                                        </label>
                                        <label class="radio-inline">
                                            @Html.RadioButtonFor(m => m.Member.MembershipType, Fire2.Areas.Front.Models.Membership.學生會員) 學生會員
                                        </label>
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(m => m.Member.Address, htmlAttributes: new { @class = "col-sm-2 control-label" })
                                    <div class="col-sm-7">
                                        @Html.TextBoxFor(m => m.Member.Address, new { @class = "form-control", placeholder = "請輸入通訊地址" })
                                    </div>
                                    <div class="col-sm-3">
                                        @Html.ValidationMessageFor(m => m.Member.Address, "", new { @class = "alertred" })

                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Member.Email, htmlAttributes: new { @class = "col-sm-2 control-label" })
                                    <div class="col-sm-7">
                                        @Html.TextBoxFor(m => m.Member.Email, new { @class = "form-control", placeholder = "請輸入email" })
                                    </div>
                                    <div class="col-sm-3">
                                        @Html.ValidationMessageFor(m => m.Member.Email, "", new { @class = "alertred" })
                                    </div>
                                </div>

                                <!-- 國際會員 checkbox -->
                                <div class="form-group">
                                    @Html.Label("國際會員證明", htmlAttributes: new { @class = "col-sm-2 control-label" })
                                    <div class="col-sm-10">
                                        <div class="checkbox">
                                            <label>
                                                @Html.CheckBoxFor(m => m.Member.IsInternationalMember)
                                                為國際縱火調查學會之當年度有效會員，請檢附會員證影本
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <!-- 上傳檔案欄位（對齊文字欄位） -->
                                <div class="form-group">
                                    <div class="col-sm-offset-2 col-sm-10">
                                        <input type="file" name="CertificateFile" class="form-control" />
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(m => m.Member.CurrentOrgnization, htmlAttributes: new { @class = "col-sm-2 control-label" })

                                    <div class="col-sm-7">
                                        @Html.TextBoxFor(m => m.Member.CurrentOrgnization, new { @class = "form-control ", placeholder = "請輸入現職單位" })
                                    </div>
                                    <div class="col-sm-3">
                                        @Html.ValidationMessageFor(m => m.Member.CurrentOrgnization, "", new { @class = "alertred" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(m => m.Member.JobTitle, htmlAttributes: new { @class = "col-sm-2 control-label" })
                                    <div class="col-sm-7">
                                        @Html.TextBoxFor(m => m.Member.JobTitle, new { @class = "form-control", placeholder = "請輸入職稱" })
                                    </div>
                                    <div class="col-sm-3">
                                        @Html.ValidationMessageFor(m => m.Member.JobTitle, "", new { @class = "alertred" })
                                    </div>

                                </div>

                                <div class="form-group">
                                    <div class="col-sm-7">
                                        @Html.LabelFor(m => m.Member.HighestEducation, htmlAttributes: new { @class = "col-sm-2 control-label" })
                                    </div>
                                    <div class="col-sm-3">
                                        @Html.TextBoxFor(m => m.Member.HighestEducation, new { @class = "form-control", placeholder = "請輸入最高學歷" })
                                    </div>
                                    <div>
                                        @Html.ValidationMessageFor(m => m.Member.HighestEducation, "", new { @class = "alertred" })
                                    </div>

                                </div>

                                <div class="boxg">
                                    <h4 class="col-sm-2"><i class="fa fa-briefcase"></i> 服務經歷</h4>





                                    @for (int i = 0; i < Model.ServiceHistories.Count(); i++)
                                    {
                                        <div class="form-group">

                                            @Html.LabelFor(m => m.ServiceHistories[i].ServiceUnit, "服務單位", new { @class = "col-sm-2 control-label" })
                                            <div class="col-sm-7">
                                                @Html.TextBoxFor(m => m.ServiceHistories[i].ServiceUnit, new { @class = "form-control", placeholder = "請輸入服務單位" })
                                            </div>
                                            @if (i == 0)
                                            {
                                                <div class="col-sm-3">
                                                    @Html.ValidationMessageFor(m => m.ServiceHistories[i].ServiceUnit, "", new { @class = "alertred" })
                                                </div>}
                                        </div>
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.ServiceHistories[i].JobTitle, "職稱：", new { @class = "col-sm-2 control-label" })
                                            <div class="col-sm-7">
                                                @Html.TextBoxFor(m => m.ServiceHistories[i].JobTitle, new { @class = "form-control", placeholder = "請輸入職稱" })
                                            </div>
                                            @if (i == 0)
                                            {
                                                <div class="col-sm-3">
                                                    @Html.ValidationMessageFor(m => m.ServiceHistories[i].JobTitle, "", new { @class = "alertred" })
                                                </div>}
                                        </div>
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.ServiceHistories[i].StartYear, "起:", new { @class = "col-sm-2 control-label" })
                                            <div class="col-sm-2">
                                                @Html.TextBoxFor(m => m.ServiceHistories[i].StartYear, new { @class = "form-control", placeholder = "年" })
                                            </div>
                                            <div class="col-sm-2">
                                                @Html.TextBoxFor(m => m.ServiceHistories[i].StartMonth, new { @class = "form-control", placeholder = "月" })
                                            </div>
                                            @if (i == 0)
                                            {
                                                <div class="col-sm-2">
                                                    @Html.ValidationMessageFor(m => m.ServiceHistories[i].StartYear, "", new { @class = "alertred" })
                                                    @Html.ValidationMessageFor(m => m.ServiceHistories[i].StartMonth, "", new { @class = "alertred" })

                                                </div>
                                            }


                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Member.TotalYears, "相關年資合計：", new { @class = "col-sm-2 control-label" })

                                            <div class="col-sm-2">
                                                @Html.TextBoxFor(m => m.Member.TotalYears, new { @class = "form-control", placeholder = "合計年資(年)" })
                                                @Html.ValidationMessageFor(m => m.Member.TotalYears, "", new { @class = "text-danger" })
                                            </div>

                                            <div class="col-sm-2">
                                                @Html.TextBoxFor(m => m.Member.TotalMonths, new { @class = "form-control", placeholder = "合計年資(月)" })
                                                @Html.ValidationMessageFor(m => m.Member.TotalMonths, "", new { @class = "text-danger" })
                                            </div>
                                        </div>




                                    }


                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(m => m.TotalYears, "相關年資合計：", new { @class = "col-sm-2 control-label" })
                                    <div class="col-sm-2">
                                        @Html.TextBoxFor(m => m.Member.TotalYears, new { @class = "form-control", placeholder = "合計年資(年)" })

                                    </div>
                                    <div class="col-sm-2">
                                        @Html.TextBoxFor(m => m.Member.TotalMonths, new { @class = "form-control", placeholder = "合計年資(月)" })

                                    </div>

                                        <div class="col-sm-2">
                                            @Html.ValidationMessageFor(m => m.Member.TotalYears, "", new { @class = "alertred" })
                                            @Html.ValidationMessageFor(m => m.Member.TotalMonths, "", new { @class = "alertred" })

                                        </div>
                                    
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Captcha, "驗證碼:", new { @class = "col-sm-2 control-label" })
                                    <div class="col-sm-3">
                                        @Html.TextBoxFor(m => m.Captcha, new { @class = "form-control", placeholder = "請輸入驗證碼" })
                                    </div>
                                    <div class="col-sm-3">
                                        <img src="@Url.Action("Image", "Captcha", new { area = "Front" })" alt="驗證碼" onclick="this.src='@Url.Action("Image", "Captcha", new { area = "Front" })?' + Math.random()" />

                                    </div>
                                </div>
                                <hr>


                                <div class="form-group">
                                    <div class="col-sm-offset-2 col-sm-10">
                                        <button class="btn btn-primary" type="submit">註冊</button>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-success text-center" style="background-color:#337ab7; color:white;">
                                <strong>@TempData["Success"]</strong>
                            </div>
                            <div class="text-center">
                                註冊成功
                            </div>
                        }

                        <div class="tags-area clearfix">
                            <div class="share-items pull-right">
                                <ul class="post-social-icons unstyled">
                                    <li><a href="#"><i class="fa fa-facebook"></i></a></li>
                                    <li><a href="#"><i class="fa fa-twitter"></i></a></li>
                                    <li><a href="#"><i class="fa fa-google-plus"></i></a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <!-- Content Col end -->
                    <!-- 內容結束 -->
                </div>
                <!-- Main row end -->
            </div>
            <!-- Conatiner end -->
        </section>
        <!-- Main container end -->
        <!-- Footer start -->
        <footer id="footer" class="footer">
            <div class="container">
                <div class="row copyright">
                    <div class="col-xs-12 col-sm-7">
                        <div class="copyright-info">
                            <span>
                                國際縱火調查人員協會臺灣分會版權所有<br>
                                Copyright © 2016 International Association of Arson Investigators Taiwan Chapter. All Rights Reserved.
                            </span>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-push-1">
                        <div class="footer-menu">
                            <a class="btn btn-dark" href="#" title="財產權宣告">財產權宣告</a>
                        </div>
                    </div>
                </div>
                <!-- Copyright end -->
                <div id="back-to-top" data-spy="affix" data-offset-top="10" class="back-to-top affix">
                    <button class="btn btn-primary" title="Back to Top">
                        <i class="fa fa-angle-double-up"></i>
                    </button>
                </div>
            </div>
            <!--/ Container end -->
        </footer>
        <!-- Footer end -->
        <!-- Javascript Files
        ================================================== -->
        <!-- initialize jQuery Library -->
        <script type="text/javascript" src="js/jquery.js"></script>
        <!-- Bootstrap jQuery -->
        <script type="text/javascript" src="js/bootstrap.min.js"></script>
        <!-- Owl Carousel -->
        <script type="text/javascript" src="js/owl.carousel.min.js"></script>
        <!-- Counter -->
        <script type="text/javascript" src="js/jquery.counterup.min.js"></script>
        <!-- Waypoints -->
        <script type="text/javascript" src="js/waypoints.min.js"></script>
        <!-- Color box -->
        <script type="text/javascript" src="js/jquery.colorbox.js"></script>
        <!-- Isotope -->
        <script type="text/javascript" src="js/isotope.js"></script>
        <script type="text/javascript" src="js/ini.isotope.js"></script>
        <!-- Google Map API Key Source -->
        <script src="http://maps.google.com/maps/api/js?sensor=false"></script>
        <!-- For Google Map -->
        <!-- Doc http://www.mkyong.com/google-maps/google-maps-api-hello-world-example/ -->
        <script type="text/javascript" src="js/gmap3.min.js"></script>
        <!-- Template custom -->
        <script type="text/javascript" src="js/custom.js"></script>
    </div>
    <!-- Body inner end -->
</body>

</html>
