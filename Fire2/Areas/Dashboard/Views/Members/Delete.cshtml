@inherits System.Web.Mvc.WebViewPage<Fire2.Areas.Front.Models.Members>
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "刪除會員";
}

<div class="del-wrap">
    <div class="del-card">
        <div class="del-head">
            <div class="del-icon">!</div>
            <div>
                <h1 class="del-title">確定要刪除這位會員？</h1>
                <p class="del-sub">此操作無法復原，刪除後相關資料可能一併移除。</p>
            </div>
        </div>

        <div class="del-summary">
            <div class="row">
                <span class="label">姓名</span>
                <span class="value">@Html.DisplayFor(m => m.Name)</span>
            </div>
            <div class="row">
                <span class="label">帳號</span>
                <span class="value">@Html.DisplayFor(m => m.Account)</span>
            </div>
            <div class="row">
                <span class="label">Email</span>
                <span class="value">@Html.DisplayFor(m => m.Email)</span>
            </div>
        </div>

        <div class="del-note">
            <strong>注意：</strong> 刪除後不可復原，請再次確認無誤。
        </div>

        @using (Html.BeginForm("Delete", "Members", new { area = "Dashboard", id = Model.Id }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)

            <div class="del-actions">
                @Html.ActionLink("取消", "Index", "Members",
                  new { area = "Dashboard" },
                  new { @class = "btn btn-ghost" })

                <button type="submit" class="btn btn-danger"
                        onclick="return confirm('確定要刪除嗎？此操作無法復原。');">
                    刪除
                </button>
            </div>
        }
    </div>
</div>

<style>
/* ===== 基本結構 ===== */
.del-wrap {
  max-width: 760px;
  margin: 40px auto;
  padding: 0 16px;
}
.del-card {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  box-shadow: 0 10px 24px rgba(0,0,0,.06);
  padding: 24px;
}

/* ===== 標頭區 ===== */
.del-head {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 12px;
}
.del-icon {
  width: 48px; height: 48px; border-radius: 50%;
  display:flex; align-items:center; justify-content:center;
  background: #fee2e2; color:#b91c1c; font-weight: 800; font-size: 20px;
}
.del-title {
  margin: 0;
  font-size: 1.25rem;
  line-height: 1.2;
}
.del-sub {
  margin: 4px 0 0;
  color: #6b7280;
}

/* ===== 資料摘要 ===== */
.del-summary { margin: 16px 0 18px; }
.del-summary .row {
  display: grid; grid-template-columns: 120px 1fr;
  column-gap: 16px; row-gap: 10px;
  padding: 10px 0;
  border-bottom: 1px dashed #e5e7eb;
}
.del-summary .row:last-child { border-bottom: 0; }
.del-summary .label { color: #6b7280; font-weight: 600; }
.del-summary .value { color: #111827; overflow-wrap: anywhere; }

/* ===== 警示 ===== */
.del-note {
  background: #fff7ed;
  border: 1px solid #fdba74;
  color: #9a3412;
  padding: 10px 12px;
  border-radius: 10px;
  margin-bottom: 18px;
}

/* ===== 按鈕 ===== */
.del-actions { display:flex; justify-content:flex-end; gap: 10px; }
.btn {
  appearance: none; border: 1px solid transparent; cursor: pointer;
  border-radius: 10px; font-weight: 700;
  padding: 10px 16px; line-height: 1;
  transition: transform .05s ease, filter .2s ease, background-color .2s ease, border-color .2s ease;
}
.btn:active { transform: translateY(1px); }

.btn-ghost {
  background: #fff; color:#374151; border-color:#d1d5db;
}
.btn-ghost:hover { background:#f9fafb; }

.btn-danger {
  background:#dc2626; border-color:#dc2626; color:#fff;
}
.btn-danger:hover { filter: brightness(0.95); }

</style>
